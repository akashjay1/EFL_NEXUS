# Exclude credentials
credentials.json
efl_users.json

# Cache and temporary files
.efl_records_cache.json
*.pyc
*.spec

# Exclude all folders except assets
/*/
!/assets/
!/tests/
.vscode/
__pycache__/

# AuditShip's deployable standalone application.
!/Korber_AuditShip/
/Korber_AuditShip/*
!/Korber_AuditShip/KORBER AuditShip.exe
!/Korber_AuditShip/_internal/
!/Korber_AuditShip/_internal/**
RELEASE_NOTES.md
sent_log.xlsx
