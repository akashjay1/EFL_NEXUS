<Window x:Class="KorberAuditShip.Views.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AuditShip Credentials (DPAPI Encrypted)"
        Width="450"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        ShowInTaskbar="False">
    <Border Margin="12"
            Background="#FFFFFF"
            BorderBrush="#EAF2FF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Körber One Credentials"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#101828" />

            <TextBlock x:Name="SourceInfoText"
                       Grid.Row="1"
                       FontFamily="Segoe UI"
                       FontSize="11.5"
                       Foreground="#667085"
                       Margin="0,3,0,12"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Username" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Height="32" Padding="8,4" FontFamily="Segoe UI" FontSize="13" BorderBrush="#CBD5E1" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Password" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Height="32" Padding="8,4" FontFamily="Segoe UI" FontSize="13" BorderBrush="#CBD5E1" />
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Fork ID (defaults to Username if blank)" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,4" />
                <TextBox x:Name="ForkIdBox" Height="32" Padding="8,4" FontFamily="Segoe UI" FontSize="13" BorderBrush="#CBD5E1" />
            </StackPanel>

            <Grid Grid.Row="6" Margin="0,10,0,0">
                <Button Content="Clear Saved"
                        HorizontalAlignment="Left"
                        Width="105"
                        Height="34"
                        Background="#E2E8F0"
                        Foreground="#101828"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ClearButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="85"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="#64748B"
                            Foreground="White"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Save"
                            Width="85"
                            Height="34"
                            Background="#2563EB"
                            Foreground="White"
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SaveButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
