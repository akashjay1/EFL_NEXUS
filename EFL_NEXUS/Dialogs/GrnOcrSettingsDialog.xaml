<Window x:Class="EflNexus.App.Dialogs.GrnOcrSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRN OCR Settings"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAF8F2">
    <StackPanel Margin="20">
        <TextBlock Text="Local OCR first; OCR.space for difficult photos"
                   FontFamily="Segoe UI"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#0F172A" />

        <TextBlock Text="OCR.space receives the header crop, or the photo if the header cannot be located.&#x0a;Enter your OCR.space API key (the website login is not an API key). Service quotas apply.&#x0a;Engine 2 reads word positions. Uploads are limited to 1 MB for free-plan compatibility.&#x0a;The API key is stored in Windows Credential Manager."
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#0F172A"
                   TextWrapping="Wrap"
                   Margin="0,10,0,10" />

        <CheckBox x:Name="EnabledCheck"
                  Content="Automatically upload difficult photos to OCR.space"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  Margin="0,6,0,6" />

        <TextBlock Text="OCR.space API endpoint (Free or your PRO endpoint)"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Margin="0,8,0,2" />
        <TextBox x:Name="EndpointBox" FontFamily="Segoe UI" FontSize="12" Padding="6,4" />

        <TextBlock Text="OCR.space API key (blank keeps the saved key)"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Margin="0,8,0,2" />
        <PasswordBox x:Name="KeyBox" FontFamily="Segoe UI" FontSize="12" Padding="6,4" />

        <TextBlock Text="Daily upload limit (positive whole number)"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Margin="0,8,0,2" />
        <TextBox x:Name="LimitBox" FontFamily="Segoe UI" FontSize="12" Padding="6,4" />

        <TextBlock x:Name="UsageText"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#0F172A"
                   TextWrapping="Wrap"
                   Margin="0,10,0,6" />

        <TextBlock x:Name="StatusText"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#0F172A"
                   TextWrapping="Wrap"
                   Margin="0,6,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Click="Close_Click" />
            <Button Content="Save Settings"
                    Padding="14,6"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
