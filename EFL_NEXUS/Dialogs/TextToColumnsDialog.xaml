<Window x:Class="EflNexus.App.Dialogs.TextToColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text to Columns"
        MinWidth="1000"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAF8F2">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP FRAME: Preview with Splits -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="InstructionLabel"
                       Grid.Row="0"
                       Text="Drag the ▼ arrows to set split points | Click on text to add splits | Click on arrow to remove"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,6" />

            <GroupBox x:Name="PreviewGroup"
                      Grid.Row="1"
                      Header="Drag arrows to split text"
                      Padding="10">
                <ScrollViewer x:Name="CanvasScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="PreviewCanvas"
                            Background="#FFFFFF"
                            ClipToBounds="True"
                            MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                            MouseMove="PreviewCanvas_MouseMove"
                            MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp" />
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="1"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- BOTTOM FRAME: Details & Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="DetailsGroup"
                      Grid.Column="0"
                      Header="📋 Column Details"
                      Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Column Name:" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" />
                            <TextBlock x:Name="ColumnNameLabel" FontFamily="Segoe UI" FontSize="12" Foreground="#2563EB" Margin="6,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Total Rows:" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" />
                            <TextBlock x:Name="TotalRowsLabel" FontFamily="Segoe UI" FontSize="12" Foreground="#16A34A" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Sample Data (first 5 rows):"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   Margin="0,10,0,5" />

                        <TextBox x:Name="SampleText"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Height="96"
                                 Background="#F5F5F5"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" />

                        <GroupBox x:Name="SplitInfoGroup"
                                  Header="Split Information"
                                  Padding="8"
                                  Margin="0,10,0,0">
                            <TextBox x:Name="SplitInfoText"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     Height="88"
                                     TextWrapping="Wrap"
                                     Background="#FFF8E1"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" />
                        </GroupBox>

                        <TextBlock x:Name="WarningLabel"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <GroupBox x:Name="ResultGroup"
                      Grid.Column="2"
                      Header="📊 Result Preview"
                      Padding="10">
                <TextBox x:Name="ResultText"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <!-- BUTTONS -->
        <Grid Grid.Row="3" Margin="10,10,10,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Clear Splits" Padding="12,5" Margin="0,0,10,0" Click="ClearSplits_Click" />
                <Button Content="Auto-Detect" Padding="12,5" Margin="0,0,10,0" Click="AutoDetect_Click" />
                <Button Content="Refresh Preview" Padding="12,5" Margin="0,0,10,0" Click="RefreshPreview_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,5" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Apply Split" Padding="14,5" Click="ApplySplit_Click" />
            </StackPanel>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="4"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="6,3">
            <TextBlock x:Name="StatusText"
                       Text="Ready - Drag arrows to set split points"
                       FontFamily="Segoe UI"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
