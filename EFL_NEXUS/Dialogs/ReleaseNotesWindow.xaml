<Window x:Class="EflNexus.App.Dialogs.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New in EFL NEXUS"
        Width="580"
        Height="490"
        MinWidth="460"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#0B1420"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Accent Bar -->
        <Border Grid.Row="0" Background="#00E5FF" />

        <!-- Header Section -->
        <Grid Grid.Row="1" Margin="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EFL NEXUS"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />
                    
                    <Border Background="#065F46"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadgeText"
                                   Text="v1.0.8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#34D399" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="SubtitleText"
                           Text="Update completed successfully! Here's what's new in this release:"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Image x:Name="HeaderLogo"
                   Grid.Column="1"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>

        <!-- Release Notes Content Area -->
        <Border Grid.Row="2"
                Background="#101D2D"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Margin="24,0,24,12">
            <ScrollViewer x:Name="NotesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,14">
                <StackPanel x:Name="NotesContentPanel">
                    <!-- Populated dynamically in code-behind -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Section -->
        <Grid Grid.Row="3" Margin="24,4,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="ShowOnUpdateCheckBox"
                      Grid.Column="0"
                      Content="Show release notes after future updates"
                      Foreground="#94A3B8"
                      FontSize="11"
                      VerticalAlignment="Center"
                      IsChecked="True" />

            <Button x:Name="GotItButton"
                    Grid.Column="1"
                    Content="Got It!"
                    Width="110"
                    Height="32"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#2563EB"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="GotItButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
