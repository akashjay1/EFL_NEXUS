<Window x:Class="EflNexus.App.Dialogs.PresenceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Monitoring Diagnostics"
        Width="490"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAF8F2">
    <StackPanel Margin="20">
        <TextBlock Text="Machine Installation UUID"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,4" />

        <TextBox x:Name="InstallationUuidBox"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="6,5"
                 Margin="0,0,0,12" />

        <TextBlock Text="Telemetry Status"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="StatusText"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#0F172A"
                   TextWrapping="Wrap"
                   MaxWidth="450"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12" />

        <TextBlock Text="Note: Cloud telemetry is provisioned machine-wide during setup.&#x0a;Operators do not need to configure or enter credentials."
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Foreground="#64748B"
                   Margin="0,0,0,16" />

        <Button Content="Close"
                HorizontalAlignment="Right"
                Padding="16,6"
                Click="Close_Click" />
    </StackPanel>
</Window>
