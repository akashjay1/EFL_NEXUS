<Window x:Class="EflNexus.App.Dialogs.ClearCacheDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clear Storage &amp; Cache"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAF8F2">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Clear Storage &amp; Cache"
                   FontFamily="Segoe UI"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Select items to remove. This frees up disk space and resets automation sessions."
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="20,16"
                Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="ProfilesCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <StackPanel Width="390">
                        <TextBlock Text="Browser Automation Profiles" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="ProfilesDescText" FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="CacheCheck" IsChecked="True" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <StackPanel Width="390">
                        <TextBlock Text="Temporary Cache &amp; WebDrivers" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Clears WebDriver binaries (~/.wdm) and Python bytecode caches."
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="WhatsAppCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <StackPanel Width="390">
                        <TextBlock Text="WhatsApp Sessions &amp; Profiles (Log Out)" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Clears WhatsApp session cookies and WebView profile so WhatsApp logs out completely."
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="TemplatesCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <StackPanel Width="390">
                        <TextBlock Text="Saved Recipient &amp; Variance Templates" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock x:Name="TemplatesDescText" FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SettingsCheck" IsChecked="False" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <StackPanel Width="390">
                        <TextBlock Text="Reconciliation Preferences &amp; Send Logs" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Resets local column mapping history (.load_reconciliation_tool_settings.json) and sent_log.xlsx."
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Select All"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#0EA5E9"
                       Cursor="Hand"
                       Margin="0,0,14,0"
                       MouseLeftButtonUp="SelectAll_Click" />
            <TextBlock Text="Deselect All"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#64748B"
                       Cursor="Hand"
                       MouseLeftButtonUp="DeselectAll_Click" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="🗑️  Clear Selected Data"
                    Click="ExecuteClear_Click"
                    Padding="18,8"
                    Margin="0,0,10,0"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"
                    Background="#DC2626"
                    BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Padding="16,8"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    Background="#E2E8F0"
                    BorderThickness="0"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
