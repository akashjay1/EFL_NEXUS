<Window x:Class="EflNexus.App.Dialogs.ConcatenateColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Concatenate Columns"
        MinWidth="1000"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAF8F2">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP: Full data preview -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="InstructionLabel"
                       Grid.Row="0"
                       Text="Preview of the sheet below. Pick columns to combine by clicking headers or using the lists below. Choose a separator and name for the new column."
                       FontFamily="Segoe UI"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,4,0,6" />

            <GroupBox x:Name="DataPreviewGroup"
                      Grid.Row="1"
                      Header="📊 Data Preview (Click column header to select/deselect)"
                      Padding="10">
                <DataGrid x:Name="PreviewGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternationCount="2"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          FontFamily="Segoe UI"
                          FontSize="12">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <EventSetter Event="Click" Handler="ColumnHeader_Click" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- BOTTOM: Column Picker + Options & Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Column picker -->
            <GroupBox x:Name="PickerGroup"
                      Grid.Column="0"
                      Header="📋 Choose Columns (in order)"
                      Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Available Columns" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,4" />
                        <ListBox x:Name="AvailableListBox"
                                 Grid.Row="1"
                                 SelectionMode="Extended"
                                 SelectionChanged="AvailableListBox_SelectionChanged"
                                 MouseDoubleClick="AvailableListBox_DoubleClick" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,16,8,0">
                        <Button Content="Add ▶" Padding="10,4" Margin="0,4" Click="AddSelected_Click" />
                        <Button Content="◀ Remove" Padding="10,4" Margin="0,4" Click="RemoveSelected_Click" />
                        <Button Content="▲ Move Up" Padding="10,4" Margin="0,4" Click="MoveUp_Click" />
                        <Button Content="▼ Move Down" Padding="10,4" Margin="0,4" Click="MoveDown_Click" />
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Columns to Concatenate (in order)" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,4" />
                        <ListBox x:Name="SelectedListBox"
                                 Grid.Row="1"
                                 SelectionMode="Extended"
                                 SelectionChanged="SelectedListBox_SelectionChanged"
                                 MouseDoubleClick="SelectedListBox_DoubleClick" />
                    </Grid>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: Options & Preview -->
            <GroupBox x:Name="OptionsGroup"
                      Grid.Column="2"
                      Header="⚙️ Options &amp; Preview"
                      Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Separator:" Width="120" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" />
                        <ComboBox x:Name="SeparatorCombo"
                                  Width="110"
                                  IsEditable="True"
                                  SelectionChanged="SeparatorCombo_Changed" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="New Column Name:" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" />
                        <TextBox x:Name="NewColumnNameBox"
                                 Grid.Column="1"
                                 Text="Concatenated"
                                 Padding="5,3"
                                 TextChanged="NewColumnNameBox_Changed" />
                    </Grid>

                    <CheckBox x:Name="DropOriginalsCheck"
                              Grid.Row="2"
                              Content="Remove original columns after concatenating"
                              FontFamily="Segoe UI"
                              FontSize="12"
                              Margin="0,6" />

                    <Button Grid.Row="3"
                            Content="Refresh Preview"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Margin="0,4,0,6"
                            Click="RefreshPreview_Click" />

                    <TextBlock Grid.Row="4"
                               Text="Result Preview:"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />

                    <TextBox x:Name="PreviewTextBox"
                             Grid.Row="5"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>
        </Grid>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,10,6">
            <Button Content="Apply Concatenate" Padding="14,5" Margin="0,0,10,0" Click="ApplyConcatenate_Click" />
            <Button Content="Cancel" Padding="14,5" Click="Cancel_Click" />
        </StackPanel>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,3">
            <TextBlock x:Name="StatusText"
                       Text="Ready - pick at least two columns to combine"
                       FontFamily="Segoe UI"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
