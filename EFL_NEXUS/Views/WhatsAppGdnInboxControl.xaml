<UserControl x:Class="EflNexus.App.Views.WhatsAppGdnInboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F2">
    <UserControl.Resources>
        <Style x:Key="WaActionBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#0D1B2A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162E4C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WaSecondaryBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="WhatsApp GDN Inbox"
                   FontFamily="Segoe UI"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#0F172A" />

        <TextBlock Grid.Row="1"
                   Text="Monitoring continues while you review requests or use other NEXUS tools. Note is the delivery location. Save edits before selecting another request."
                   FontSize="12.5"
                   Foreground="#334155"
                   TextWrapping="Wrap"
                   Margin="0,4,0,10" />

        <!-- Split Pane: Left Requests + Paste / Right Review & Raw -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Requests (saved locally)"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#0F172A" />

                <Button Grid.Row="1"
                        Content="Clear List"
                        HorizontalAlignment="Left"
                        Style="{StaticResource WaSecondaryBtn}"
                        Margin="0,4,0,6"
                        Click="ClearList_Click" />

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,10">
                    <DataGrid x:Name="RequestsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="#FFFFFF"
                              BorderThickness="0"
                              RowHeight="26"
                              FontSize="12"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              SelectionChanged="RequestsGrid_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="#374151" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#D1D5DB" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Gate Pass" Binding="{Binding Gatepass}" Width="85" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115" />
                            <DataGridTextColumn Header="State" Binding="{Binding RunState}" Width="110" />
                            <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="*" MinWidth="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Grid.Row="3"
                           Text="Paste a single WhatsApp message"
                           FontSize="12.5"
                           Foreground="#0F172A"
                           Margin="0,0,0,4" />

                <TextBox x:Name="PasteTextBox"
                         Grid.Row="4"
                         Height="130"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="12.5"
                         Padding="6"
                         Background="#FFFFFF"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Margin="0,0,0,6" />

                <StackPanel Grid.Row="5" Orientation="Horizontal">
                    <Button Content="Import Pasted Text"
                            Style="{StaticResource WaSecondaryBtn}"
                            Click="ImportPasted_Click" />
                    <Button Content="Import from Clipboard"
                            Style="{StaticResource WaSecondaryBtn}"
                            Margin="8,0,0,0"
                            Click="ImportClipboard_Click" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" />

            <!-- Right Column -->
            <Grid Grid.Column="2" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- Fields Table -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Warehouse ID" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,8" />
                    <TextBox x:Name="WhBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Client Code" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,8" />
                    <TextBox x:Name="ClientBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gate Pass No." Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,8" />
                    <TextBox x:Name="GatePassBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Delivery Location (Note)" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,4,10,8" />
                    <TextBox x:Name="DeliveryBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Height="62"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12.5"
                             Padding="6"
                             Background="#FFFFFF"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Seal No." Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,8" />
                    <TextBox x:Name="SealBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Door Location" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,4" />
                    <TextBlock x:Name="DoorText" Grid.Row="5" Grid.Column="1" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,4" />
                </Grid>

                <!-- Warnings -->
                <TextBlock x:Name="WarningsText"
                           Grid.Row="1"
                           Text="Select a request to review. Note is the delivery location."
                           Foreground="#B45309"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,8" />

                <!-- Target Lane -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Target lane" VerticalAlignment="Center" FontSize="12.5" Foreground="#0F172A" />
                    <ComboBox x:Name="LaneCombo" Width="190" Margin="8,0,0,0" IsEditable="False" FontSize="12.5" Padding="6,4" />
                </StackPanel>

                <!-- Action Buttons -->
                <WrapPanel Grid.Row="3" Margin="0,8,0,8">
                    <Button Content="Save Review" Style="{StaticResource WaSecondaryBtn}" Margin="0,0,6,4" Click="SaveReview_Click" />
                    <Button Content="Fill Form" Style="{StaticResource WaSecondaryBtn}" Margin="0,0,6,4" Click="FillForm_Click" />
                    <Button Content="Run Gatepass" Style="{StaticResource WaActionBtn}" Margin="0,0,6,4" Click="RunGatepass_Click" />
                    <Button Content="Add to Queue" Style="{StaticResource WaSecondaryBtn}" Margin="0,0,0,4" Click="AddToQueue_Click" />
                </WrapPanel>

                <TextBlock Grid.Row="4"
                           Text="Original message"
                           FontSize="12.5"
                           Foreground="#0F172A"
                           Margin="0,2,0,4" />

                <TextBox x:Name="RawTextBox"
                         Grid.Row="5"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="11.5"
                         Padding="6"
                         Background="#F8FAFC"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Foreground="#0F172A" />
            </Grid>
        </Grid>

        <!-- Bottom Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Review captured requests or import a message manually."
                   FontSize="12"
                   Foreground="#334155"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
    </Grid>
</UserControl>
