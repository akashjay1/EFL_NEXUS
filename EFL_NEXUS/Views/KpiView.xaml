<UserControl x:Class="EflNexus.App.Views.KpiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F2">
    <UserControl.Resources>
        <Style x:Key="KpiHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#162E4C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3F66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="18,0,18,10" />
        </Style>

        <Style x:Key="KpiRefreshBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#0D1B2A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162E4C" />
                    <Setter Property="Foreground" Value="#00E5FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KpiDownloadBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAF8F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0B1420" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="User KPI"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="Operator task logging, job record management, Google Sheets live sync, and daily KPI tracking"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button x:Name="SettingsBtn"
                        DockPanel.Dock="Right"
                        Content="⚙ Settings"
                        Style="{StaticResource KpiHeaderBtn}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="Settings_Click" />
            </DockPanel>
        </Border>

        <!-- User & Date Row -->
        <DockPanel Grid.Row="1" Margin="18,10,18,8" LastChildFill="False">
            <Border DockPanel.Dock="Left"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="13" Foreground="#64748B" Margin="0,0,5,0" />
                    <TextBlock Text="Operator:" FontSize="12" Foreground="#64748B" Margin="0,0,4,0" />
                    <TextBlock x:Name="UserLabelText" Text="Not configured" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="|" FontSize="12" Foreground="#E2E8F0" Margin="6,0" />
                    <TextBlock Text="Code:" FontSize="12" Foreground="#64748B" Margin="0,0,4,0" />
                    <TextBlock x:Name="UserCodeText" Text="" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DateModeText"
                           Text=""
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#DC2626"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="Date:"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <!-- Custom DatePicker Chip -->
                <Border x:Name="DateChipBorder"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="6,3"
                        Cursor="Hand"
                        MouseLeftButtonDown="DateChip_MouseLeftButtonDown"
                        MouseEnter="DateChip_MouseEnter"
                        MouseLeave="DateChip_MouseLeave">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="12" Foreground="#64748B" Margin="0,0,4,0" />
                        <TextBlock x:Name="DateDisplayText"
                                   Text=""
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="▾" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Popup x:Name="CalendarPopup"
                       PlacementTarget="{Binding ElementName=DateChipBorder}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Width="248">
                        <StackPanel>
                            <Border Background="#0B1420" Padding="8,6">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="◀"
                                               DockPanel.Dock="Left"
                                               Foreground="#FFFFFF"
                                               FontWeight="Bold"
                                               Cursor="Hand"
                                               Padding="4,0"
                                               MouseLeftButtonDown="PrevMonth_MouseDown" />
                                    <TextBlock Text="▶"
                                               DockPanel.Dock="Right"
                                               Foreground="#FFFFFF"
                                               FontWeight="Bold"
                                               Cursor="Hand"
                                               Padding="4,0"
                                               MouseLeftButtonDown="NextMonth_MouseDown" />
                                    <TextBlock x:Name="CalendarMonthText"
                                               Text=""
                                               Foreground="#FFFFFF"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="7" Background="#F8FAFC" Margin="0,0,0,2">
                                <TextBlock Text="Mo" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                                <TextBlock Text="Tu" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                                <TextBlock Text="We" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                                <TextBlock Text="Th" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                                <TextBlock Text="Fr" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                                <TextBlock Text="Sa" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                                <TextBlock Text="Su" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" FontWeight="Bold" Padding="0,4" />
                            </UniformGrid>

                            <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Margin="4,2" />

                            <Border Background="#F8FAFC" Padding="6,4">
                                <Button Content="Today"
                                        Background="#FFFFFF"
                                        Foreground="#0F172A"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Padding="0,3"
                                        Cursor="Hand"
                                        Click="PopupToday_Click" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Content="Today"
                        Margin="8,0,0,0"
                        Background="#FFFFFF"
                        Foreground="#0F172A"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        FontSize="12"
                        FontWeight="Bold"
                        Padding="9,3"
                        Cursor="Hand"
                        Click="TodayBtn_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Warehouse Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,0,18,8" VerticalAlignment="Center">
            <TextBlock Text="Warehouse:"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="WarehouseCombo"
                      Width="120"
                      FontSize="12"
                      Padding="6,3"
                      IsEditable="False"
                      DropDownOpened="WarehouseCombo_DropDownOpened"
                      SelectionChanged="WarehouseCombo_SelectionChanged" />
            <TextBlock Text="Site count: your tasks in the selected warehouse. Day total: your tasks across all warehouses for the selected date."
                       FontSize="12"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Scrollable Panels -->
        <ScrollViewer Grid.Row="3" x:Name="BodyScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Top Panel: Reconciliation & Load Plan -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Reconciliation &amp; Load Plan"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />
                            <TextBlock Text="Job ID / Status"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,1" />
                        </StackPanel>
                        <StackPanel x:Name="TopRowsHost" />
                    </StackPanel>
                </Border>

                <!-- Bottom Panel: Audit, Shipping & Transfers -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Audit, Shipping &amp; Transfers"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A" />
                            <TextBlock Text="— Load audit, shipping confirmation, transfer movements &amp; allocation"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,1" />
                        </StackPanel>
                        <StackPanel x:Name="BottomRowsHost" />
                    </StackPanel>
                </Border>

                <!-- Collapsible Activity Log Card -->
                <Border Style="{StaticResource KpiCardStyle}" Padding="14,8">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Activity Log"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center" />
                                <Border Background="#F1F5F9" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LogCountBadge"
                                               Text="0 events"
                                               FontSize="11"
                                               Foreground="#64748B" />
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="📋 Copy"
                                        Background="#FFFFFF"
                                        Foreground="#64748B"
                                        BorderThickness="0"
                                        FontSize="11"
                                        Padding="6,2"
                                        Cursor="Hand"
                                        Margin="4,0,0,0"
                                        Click="CopyLog_Click" />
                                <Button Content="🗑 Clear"
                                        Background="#FFFFFF"
                                        Foreground="#64748B"
                                        BorderThickness="0"
                                        FontSize="11"
                                        Padding="6,2"
                                        Cursor="Hand"
                                        Margin="4,0,0,0"
                                        Click="ClearLog_Click" />
                                <Button x:Name="LogToggleBtn"
                                        Content="▾ Hide"
                                        Background="#FFFFFF"
                                        Foreground="#64748B"
                                        BorderThickness="0"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Padding="6,2"
                                        Cursor="Hand"
                                        Margin="4,0,0,0"
                                        Click="ToggleLog_Click" />
                            </StackPanel>
                        </DockPanel>

                        <RichTextBox x:Name="LogRichBox"
                                     Margin="0,6,0,0"
                                     Height="78"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="#F8FAFC"
                                     Foreground="#334155"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="18,0,18,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshBtn"
                        Content="Refresh"
                        Style="{StaticResource KpiRefreshBtn}"
                        Click="Refresh_Click" />
                <Button x:Name="DownloadBtn"
                        Content="Download KPI"
                        Style="{StaticResource KpiDownloadBtn}"
                        Margin="6,0,0,0"
                        Click="Download_Click" />
            </StackPanel>

            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Height="32"
                    Padding="10,0"
                    Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MsgIcon"
                               Text="✦"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#00E5FF"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MsgLabel"
                               Text="Ready"
                               FontSize="12"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Warehouse Switch / Refresh Card Overlay (scoped to KpiView only) -->
        <Grid x:Name="WarehouseLoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              Background="#E6FAF8F2"
              Visibility="Collapsed"
              Cursor="Wait">
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="WarehouseLoadingText"
                               Text="Loading..."
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Refreshing your KPI counts. Please wait..."
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    <ProgressBar IsIndeterminate="True"
                                 Width="260"
                                 Height="10"
                                 Foreground="#00E5FF"
                                 Background="#E2E8F0"
                                 BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
