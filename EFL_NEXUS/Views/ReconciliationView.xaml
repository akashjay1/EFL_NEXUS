<UserControl x:Class="EflNexus.App.Views.ReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F2">
    <UserControl.Resources>
        <Style x:Key="ReconHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#162E4C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3F66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReconGroupStyle" TargetType="GroupBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#FAF8F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0B1420" Padding="20,16,20,14">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="HeaderTitleLabel"
                               Text="Load Reconciliation"
                               DockPanel.Dock="Left"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SendVarianceBtn"
                                Content="📧 Send Variance"
                                Style="{StaticResource ReconHeaderBtn}"
                                Click="SendVariance_Click" />
                        <Button x:Name="SettingsBtn"
                                Content="⚙ Settings"
                                Style="{StaticResource ReconHeaderBtn}"
                                Margin="6,0,0,0"
                                Visibility="Collapsed"
                                Click="OpenSettings_Click" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="HeaderSubtitleLabel"
                           Text="Compare Actual Dispatches Against Planned Loads"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Two-Column Workspace -->
        <Grid Grid.Row="1" Margin="18,14,18,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="535" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Queued Jobs + Files + Output + Options + Progress + Actions -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Queued Reconciliation Jobs -->
                    <GroupBox x:Name="QueueGroup" Header="Queued Reconciliation Jobs" Style="{StaticResource ReconGroupStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Job ID:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="QueueCombo" Grid.Column="1" Margin="0,0,10,0" Padding="6,4" IsEditable="False" VerticalAlignment="Center" SelectionChanged="QueueCombo_SelectionChanged" />
                                <StackPanel Grid.Column="2" Width="88">
                                    <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11.5" Click="RefreshQueue_Click" />
                                    <Button Content="Clear Queue" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" Margin="0,4,0,0" Click="ClearQueue_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="QueueHintText"
                                       Text="Optional: select a queued Job ID to save the report in its own folder."
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Foreground="#64748B"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Select Files -->
                    <GroupBox x:Name="FilesGroup" Header="📁 Select Files" Style="{StaticResource ReconGroupStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Loading History -->
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Loading History:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="HistoryPathBox" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="12" Click="BrowseHistory_Click" />
                            </Grid>
                            <TextBlock x:Name="HistoryInfoText" Text="No file selected" FontSize="11" FontWeight="Normal" Foreground="#64748B" Margin="10,2,0,4" />

                            <Grid Margin="10,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HistoryLoadIdLabel" Grid.Column="0" Text="🔑 Primary Key (Load ID):" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="HistoryLoadIdCombo" Grid.Column="1" Padding="6,4" IsEditable="False" SelectionChanged="HistoryColCombo_SelectionChanged" />
                            </Grid>

                            <Grid Margin="10,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔢 Quantity Column:" FontWeight="Normal" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="HistoryQtyCombo" Grid.Column="1" Padding="6,4" IsEditable="False" SelectionChanged="HistoryColCombo_SelectionChanged" />
                            </Grid>

                            <Button x:Name="HistoryConcatBtn"
                                    Content="🔗 Concatenate Columns..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="10,5,0,4"
                                    Padding="10,4"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="HistoryConcat_Click" />

                            <CheckBox x:Name="HistorySplitCheck"
                                      Content="Enable Text-to-Columns (Fixed Width)"
                                      FontWeight="Normal"
                                      Margin="10,6,0,2"
                                      Checked="HistorySplitCheck_Changed"
                                      Unchecked="HistorySplitCheck_Changed" />

                            <Grid Margin="10,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Column to Split:" FontWeight="Normal" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="HistorySplitCombo" Grid.Column="1" Margin="0,0,8,0" Padding="6,4" IsEditable="False" IsEnabled="False" />
                                <Button x:Name="HistoryConfigureSplitBtn" Grid.Column="2" Content="Configure Split" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="12" IsEnabled="False" Click="HistoryConfigureSplit_Click" />
                            </Grid>

                            <!-- Load Plan -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Load Plan:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="PlanPathBox" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="12" Click="BrowsePlan_Click" />
                            </Grid>
                            <TextBlock x:Name="PlanInfoText" Text="No file selected" FontSize="11" FontWeight="Normal" Foreground="#64748B" Margin="10,2,0,4" />

                            <Grid Margin="10,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlanLoadIdLabel" Grid.Column="0" Text="🔑 Primary Key (Load ID):" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="PlanLoadIdCombo" Grid.Column="1" Padding="6,4" IsEditable="False" SelectionChanged="PlanColCombo_SelectionChanged" />
                            </Grid>

                            <Grid Margin="10,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔢 Quantity Column:" FontWeight="Normal" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="PlanQtyCombo" Grid.Column="1" Padding="6,4" IsEditable="False" SelectionChanged="PlanColCombo_SelectionChanged" />
                            </Grid>

                            <Button x:Name="PlanConcatBtn"
                                    Content="🔗 Concatenate Columns..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="10,5,0,4"
                                    Padding="10,4"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="PlanConcat_Click" />

                            <StackPanel Orientation="Horizontal" Margin="10,6,0,2">
                                <CheckBox x:Name="PlanDivideCheck"
                                          Content="Divide Plan Qty by:"
                                          FontWeight="Normal"
                                          VerticalAlignment="Center"
                                          Checked="PlanDivideCheck_Changed"
                                          Unchecked="PlanDivideCheck_Changed" />
                                <TextBox x:Name="PlanDivideBox"
                                         Width="65"
                                         Text="1"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Margin="6,0,6,0"
                                         Padding="6,3"
                                         IsEnabled="False" />
                                <TextBlock x:Name="PlanDivideHintText"
                                           Text="(before comparing)"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <CheckBox x:Name="PlanSplitCheck"
                                      Content="Enable Text-to-Columns (Fixed Width)"
                                      FontWeight="Normal"
                                      Margin="10,6,0,2"
                                      Checked="PlanSplitCheck_Changed"
                                      Unchecked="PlanSplitCheck_Changed" />

                            <Grid Margin="10,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Column to Split:" FontWeight="Normal" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="PlanSplitCombo" Grid.Column="1" Margin="0,0,8,0" Padding="6,4" IsEditable="False" IsEnabled="False" />
                                <Button x:Name="PlanConfigureSplitBtn" Grid.Column="2" Content="Configure Split" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="12" IsEnabled="False" Click="PlanConfigureSplit_Click" />
                            </Grid>

                            <TextBlock x:Name="ErrorText"
                                       Text=""
                                       Foreground="#EF4444"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="10,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Output Settings -->
                    <GroupBox x:Name="OutputGroup" Header="📂 Output Settings" Style="{StaticResource ReconGroupStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output Folder:" FontWeight="Normal" VerticalAlignment="Center" />
                                <TextBox x:Name="OutputFolderBox" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="12" Click="BrowseOutputFolder_Click" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Archive Folder:" FontWeight="Normal" VerticalAlignment="Center" />
                                <TextBox x:Name="ArchiveFolderBox" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="12" Click="BrowseArchiveFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Options -->
                    <GroupBox x:Name="OptionsGroup" Header="⚙️ Options" Style="{StaticResource ReconGroupStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="ArchiveCheck" Content="Archive files after processing" FontWeight="Normal" IsChecked="True" Margin="0,0,0,4" />
                                <CheckBox x:Name="AutoOpenCheck" Content="Auto-open result file after completion" FontWeight="Normal" IsChecked="True" />
                            </StackPanel>
                            <CheckBox x:Name="VerboseLogCheck" Grid.Column="1" Content="Verbose logging" FontWeight="Normal" VerticalAlignment="Top" />
                        </Grid>
                    </GroupBox>

                    <!-- Progress + Status -->
                    <ProgressBar x:Name="ReconProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#00B7FF" Background="#E2E8F0" BorderThickness="0" />
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12.5" FontWeight="Normal" Margin="0,5,0,10" />

                    <!-- Action Buttons -->
                    <Button x:Name="RunBtn"
                            Content="🚀 Run Reconciliation"
                            Background="#00B7FF"
                            Foreground="#FFFFFF"
                            FontSize="15"
                            FontWeight="Bold"
                            Padding="12,10"
                            Style="{StaticResource NexusButtonBase}"
                            Click="RunReconciliation_Click" />

                    <DockPanel Margin="0,8,0,6" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Clear All" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="ClearAll_Click" />
                        <Button DockPanel.Dock="Left" Content="Clear Log" Style="{StaticResource SecondaryButtonStyle}" Click="ClearLog_Click" />
                        <Button DockPanel.Dock="Right" Content="Exit" Style="{StaticResource SecondaryButtonStyle}" Click="Exit_Click" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Data Preview (top) + GridSplitter + Activity Log (bottom) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="240" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="2*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- Data Preview -->
                <GroupBox x:Name="PreviewGroup" Grid.Row="0" Header="📊 Data Preview" Style="{StaticResource ReconGroupStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top: Loading History Preview -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Loading History (Top)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="HistoryPreviewCountText" DockPanel.Dock="Left" Text="No data loaded" FontSize="11" FontWeight="Normal" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11.5" Click="RefreshHistoryPreview_Click" />
                            </DockPanel>
                            <DataGrid x:Name="HistoryPreviewGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      FontSize="12"
                                      SelectionChanged="HistoryPreviewGrid_SelectionChanged" />
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#E2E8F0" ResizeDirection="Rows" />

                        <!-- Bottom: Load Plan Preview -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Load Plan (Bottom)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlanPreviewCountText" DockPanel.Dock="Left" Text="No data loaded" FontSize="11" FontWeight="Normal" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" FontSize="11.5" Click="RefreshPlanPreview_Click" />
                            </DockPanel>
                            <DataGrid x:Name="PlanPreviewGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      FontSize="12"
                                      SelectionChanged="PlanPreviewGrid_SelectionChanged" />
                        </Grid>

                        <!-- Row Inspection Status Bar -->
                        <Border x:Name="PreviewStatusBorder" Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Margin="0,8,0,0">
                            <TextBlock x:Name="PreviewStatusText"
                                       Text="👆 Click a row in either preview below to see its values here"
                                       FontSize="11.5"
                                       FontWeight="Normal"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Border>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#E2E8F0" ResizeDirection="Rows" />

                <!-- Activity Log -->
                <GroupBox x:Name="LogGroup" Grid.Row="2" Header="📋 Activity Log" Style="{StaticResource ReconGroupStyle}">
                    <RichTextBox x:Name="LogRichText"
                                 IsReadOnly="True"
                                 Background="#0B1420"
                                 Foreground="#F8FAFC"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Padding="6">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0,1,0,1" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Footer -->
        <TextBlock x:Name="FooterText"
                   Grid.Row="2"
                   Text="© 2026 Load Reconciliation v2.1 | Made with ❤️"
                   FontSize="11"
                   Foreground="#94A3B8"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,8" />
    </Grid>
</UserControl>
