<UserControl x:Class="EflNexus.App.Views.AuditShipHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#FAF8F2">
    <Grid>
        <!-- Embedded Child Window Host (collapsed whenever overlay or another page is active) -->
        <wfi:WindowsFormsHost x:Name="AuditShipHostControl"
                              Visibility="Collapsed"
                              SizeChanged="AuditShipHostControl_SizeChanged" />

        <!-- Initial Launcher Card -->
        <Grid x:Name="LauncherOverlay" Background="#FAF8F2">
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🚚"
                               FontFamily="Segoe UI Emoji"
                               FontSize="42"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Korber AuditShip"
                               FontFamily="Segoe UI"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,4" />
                    <TextBlock Text="Audit outbound loads and complete shipping workflows&#x0A;through the Korber One Mobile portal."
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />
                    <Button x:Name="LaunchBtn"
                            Content="  Open AuditShip  "
                            Style="{StaticResource DarkButtonStyle}"
                            FontSize="13.5"
                            Padding="20,8"
                            HorizontalAlignment="Center"
                            Click="OpenAuditShip_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#F3F6FA" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading Korber AuditShip…"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#334155"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Preparing the unified workspace"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Error / Exit Overlay -->
        <Grid x:Name="ErrorOverlay" Background="#F3F6FA" Visibility="Collapsed">
            <Border Background="#FFFFFF"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    Padding="28,24"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ErrorTitleText"
                               Text="AuditShip is not running"
                               FontFamily="Segoe UI"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#B91C1C" />
                    <TextBlock x:Name="ErrorDetailText"
                               Text=""
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18" />
                    <Button Content="Retry AuditShip"
                            Style="{StaticResource DarkButtonStyle}"
                            Padding="16,8"
                            HorizontalAlignment="Left"
                            Click="RetryAuditShip_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
