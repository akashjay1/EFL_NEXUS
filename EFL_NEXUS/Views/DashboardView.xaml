<UserControl x:Class="EflNexus.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F2">
    <Grid>
        <!-- Aurora Borealis Background Texture -->
        <Image x:Name="AuroraBgImage"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               IsHitTestVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,36,48,36">
                <!-- Hero Header -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome to EFL NEXUS"
                                   FontFamily="Segoe UI"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="High-performance automation &amp; variance reconciliation workspace."
                                   FontFamily="Segoe UI"
                                   FontSize="14.5"
                                   Foreground="#475569"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border x:Name="DashStatusPill"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="#E2FDF2"
                            BorderBrush="#49CF9E"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="14,7">
                        <TextBlock x:Name="DashStatusText"
                                   Text="●  SYSTEM OPERATIONAL"
                                   FontFamily="Segoe UI"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#065F46" />
                    </Border>
                </Grid>

                <!-- Row 1: 4 Primary Tool Cards -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Korber Automation -->
                    <Border x:Name="CardTool1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="tool1|#00E5FF">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#00E5FF" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="🔧" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="QUEUE &amp; AUTO-RETRY" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Korber Automation" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Dual-lane automated GDN / GRN creation with persistent browser sessions and auto-recovery."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnTool1" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextTool1" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 2: Load Reconciliation -->
                    <Border x:Name="CardTool2" Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="tool2|#49CF9E">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#49CF9E" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="⚡" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="VARIANCE ANALYTICS" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#49CF9E" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Load Reconciliation" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Reconcile Loading History against Load Plans, generate variances, and export Excel reports."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnTool2" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextTool2" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 3: Outlook Email Sender -->
                    <Border x:Name="CardTool3" Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="tool3|#00B7FF">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#00B7FF" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="📧" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="DIRECT MAIL ENGINE" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#00B7FF" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Outlook Email Sender" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Send batch dispatch emails through native Outlook with dynamic templates and audit logs."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnTool3" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextTool3" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 4: User KPI -->
                    <Border x:Name="CardTool4" Grid.Column="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="tool4|#FF6B00">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#FF6B00" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="👥" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="TASK &amp; METRIC LOGS" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FF6B00" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="User KPI" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Operator task logging, job record management, Google Sheets live sync, and daily KPI tracking."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnTool4" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextTool4" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Secondary Tool Cards -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 5: Korber AuditShip -->
                    <Border x:Name="CardTool5" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="tool5|#00E5FF">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#00E5FF" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="🚚" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="SHIPPING &amp; AUDIT" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Korber AuditShip" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Audit outbound loads and complete shipping workflows through the Korber One Mobile portal."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnTool5" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextTool5" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 6: Pending Jobs -->
                    <Border x:Name="CardTool6" Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="tool6|#A855F7">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#A855F7" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="🔗" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="AUTHORISED WEB EXTRACTION" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#A855F7" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Pending Jobs" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Sign in to an authorised portal, open reconciliation, and export every Job ID."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnTool6" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextTool6" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Card 7: Packing List Generator -->
                    <Border x:Name="CardPackingList" Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="Card_Click" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" Tag="packinglist|#3498DB">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="4" Background="#3498DB" />
                            <Grid Margin="22,20,22,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Border Width="42" Height="42" Background="#F1F5F9" HorizontalAlignment="Left">
                                        <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A" />
                                    </Border>
                                    <Border Background="#0D1B2A" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="EXCEL &amp; OUTLOOK" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#3498DB" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Packing List Generator" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="Generate SPAR packing lists from loading reports, custom MLP ordering, and auto-draft Outlook emails."
                                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Border x:Name="BtnPackingList" Grid.Row="3" Background="#0D1B2A" Padding="14,7" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BtnTextPackingList" Text="Open Tool  →" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Bottom Platform Capabilities Banner -->
                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="24,20"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="PLATFORM CAPABILITIES"
                                   FontFamily="Segoe UI"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="⚡ Instant Tool Switching" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,3" />
                                    <TextBlock Text="Pre-warmed background modules for zero-delay navigation." FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="🛡 Isolated Dual Lanes" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,3" />
                                    <TextBlock Text="Run bulk jobs in Lane A while priority items execute in Lane B." FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="📊 Automated Variance &amp; Logs" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,3" />
                                    <TextBlock Text="Instant discrepancy calculations, Excel export, and dispatch audit logs." FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
