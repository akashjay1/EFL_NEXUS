<UserControl x:Class="EflNexus.App.Views.KorberToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EflNexus.App.Views"
             Background="#FAF8F2">
    <UserControl.Resources>
        <Style x:Key="LaneTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D1B2A" />
                                <Setter Property="Foreground" Value="#00E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAF8F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1B2A" Padding="16,8">
            <TextBlock Text="✦  Lane A &amp; Lane B run independently — each creates its own isolated browser session."
                       Foreground="#00E5FF"
                       FontSize="12"
                       FontWeight="Bold" />
        </Border>

        <TabControl x:Name="LaneTabControl"
                    Grid.Row="1"
                    Background="#FAF8F2"
                    BorderThickness="0"
                    Padding="0"
                    ItemContainerStyle="{StaticResource LaneTabItemStyle}">
            <TabItem Header="  Lane A (Default)  ">
                <views:KorberLaneControl x:Name="LaneA" ProfileName="lane_a" />
            </TabItem>
            <TabItem Header="  Lane B (Priority)  ">
                <views:KorberLaneControl x:Name="LaneB" ProfileName="lane_b" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
