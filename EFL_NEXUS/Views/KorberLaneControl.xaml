<UserControl x:Class="EflNexus.App.Views.KorberLaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F2">
    <UserControl.Resources>
        <Style x:Key="KorberPrimaryBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#0D1B2A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162E4C" />
                    <Setter Property="Foreground" Value="#00E5FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8" />
                    <Setter Property="Foreground" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KorberSecondaryBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KorberHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#162E4C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3F66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KorberTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="KorberTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0"
                                BorderThickness="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D1B2A" />
                                <Setter Property="Foreground" Value="#00E5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAF8F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0B1420" Padding="20,16,20,14">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Körber Automation"
                               DockPanel.Dock="Left"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RestartBtn" Content="Restart" Style="{StaticResource KorberHeaderBtn}" Margin="0,0,6,0" Click="Restart_Click" />
                        <Button x:Name="TerminateBtn" Content="Terminate" Style="{StaticResource KorberHeaderBtn}" Margin="0,0,6,0" Click="Terminate_Click" />
                        <Button x:Name="AboutBtn" Content="About" Style="{StaticResource KorberHeaderBtn}" Click="About_Click" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="GDN / GRN creation bot"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="170" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tabs: GDN / GRN -->
                <TabControl x:Name="DocTabControl"
                            Grid.Row="0"
                            Style="{StaticResource KorberTabControlStyle}"
                            ItemContainerStyle="{StaticResource KorberTabItemStyle}">
                    <TabItem Header="  GDN  ">
                        <Border Background="#FFFFFF" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Warehouse ID" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,12" />
                                <ComboBox x:Name="GdnWarehouseCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Padding="8,6" FontSize="13" IsEditable="False" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Client Code" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,12" />
                                <TextBox x:Name="GdnClientBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Gate Pass No." Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,12" />
                                <TextBox x:Name="GdnGatePassBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Delivery Location" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,12" />
                                <TextBox x:Name="GdnDeliveryBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Seal No." Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,20" />
                                <TextBox x:Name="GdnSealBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" />

                                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="GdnRunBtn"
                                            Grid.Column="0"
                                            Content="Create GDN"
                                            Style="{StaticResource KorberPrimaryBtn}"
                                            Margin="0,0,6,0"
                                            Click="CreateGdn_Click" />
                                    <Button x:Name="GdnQueueBtn"
                                            Grid.Column="1"
                                            Content="+ Add to Queue"
                                            Style="{StaticResource KorberSecondaryBtn}"
                                            Margin="6,0,0,0"
                                            Click="AddGdnToQueue_Click" />
                                </Grid>

                                <Button x:Name="WhatsAppInboxBtn"
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Content="WhatsApp GDN Inbox"
                                        Style="{StaticResource KorberSecondaryBtn}"
                                        Margin="0,8,0,0"
                                        Click="WhatsAppInbox_Click" />
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="  GRN  ">
                        <Border Background="#FFFFFF" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Warehouse ID" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,12" />
                                <ComboBox x:Name="GrnWarehouseCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Padding="8,6" FontSize="13" IsEditable="False" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gate Pass No." Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,20" />
                                <TextBox x:Name="GrnGatePassBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20" />

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="GrnRunBtn"
                                            Grid.Column="0"
                                            Content="Create GRN"
                                            Style="{StaticResource KorberPrimaryBtn}"
                                            Margin="0,0,6,0"
                                            Click="CreateGrn_Click" />
                                    <Button x:Name="GrnQueueBtn"
                                            Grid.Column="1"
                                            Content="+ Add to Queue"
                                            Style="{StaticResource KorberSecondaryBtn}"
                                            Margin="6,0,0,0"
                                            Click="AddGrnToQueue_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Clear button -->
                <Button x:Name="ClearFieldsBtn"
                        Grid.Row="1"
                        Content="Clear All Fields"
                        Style="{StaticResource KorberSecondaryBtn}"
                        Margin="0,14,0,0"
                        Click="ClearFields_Click" />

                <!-- Queue Section Header -->
                <TextBlock Grid.Row="2"
                           Text="Queue"
                           FontSize="14.5"
                           FontWeight="Bold"
                           Foreground="#0B1420"
                           Margin="0,18,0,6" />

                <!-- Queue DataGrid -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid x:Name="QueueGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="#FFFFFF"
                              BorderThickness="0"
                              RowHeight="28"
                              FontSize="12.5"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="#374151" />
                                <Setter Property="FontFamily" Value="Segoe UI" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#D1D5DB" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{Binding StatusForeground}" />
                                <Setter Property="FontWeight" Value="{Binding StatusFontWeight}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding DocType}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Gate Pass No." Binding="{Binding GatePassNumber}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="6,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Queue Action Buttons -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunQueueBtn" Grid.Column="0" Content="Run Queue" Style="{StaticResource KorberPrimaryBtn}" Margin="0,0,4,0" Click="RunQueue_Click" />
                    <Button x:Name="StopItemBtn" Grid.Column="1" Content="Stop Selected" Style="{StaticResource KorberSecondaryBtn}" Margin="4,0,4,0" Click="StopSelected_Click" />
                    <Button x:Name="ClearQueueBtn" Grid.Column="2" Content="Clear Queue" Style="{StaticResource KorberSecondaryBtn}" Margin="4,0,0,0" Click="ClearQueue_Click" />
                </Grid>

                <!-- Status Card -->
                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="Fill in the details, then choose GDN or GRN"
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="StatusProgressBar"
                                 Height="8"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#00E5FF"
                                 Background="#E2E8F0"
                                 BorderThickness="0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
