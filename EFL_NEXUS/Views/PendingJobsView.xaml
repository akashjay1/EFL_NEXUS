<UserControl x:Class="EflNexus.App.Views.PendingJobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#FAF8F2">

    <Grid Margin="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Single-Row Top Header Banner -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Pending Jobs"
                       FontFamily="Segoe UI"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center" />

            <Button x:Name="RunBtn"
                    Grid.Column="1"
                    Content="Open Both Browsers"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,5"
                    FontSize="12"
                    Margin="14,0,0,0"
                    Click="RunBtn_Click" />

            <Button x:Name="RestartBtn"
                    Grid.Column="2"
                    Content="🔄 Restart Browser"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,5"
                    FontSize="12"
                    Margin="6,0,0,0"
                    Click="RestartBtn_Click" />

            <TextBlock x:Name="StatusText"
                       Grid.Column="3"
                       Text="Ready. Click 'Open Both Browsers' to launch Reconciliation and Loading History."
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#475569"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0,10,0" />

            <Button x:Name="SettingsBtn"
                    Grid.Column="4"
                    Content="⚙ Settings"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,5"
                    FontSize="12"
                    Click="SettingsBtn_Click" />
        </Grid>

        <!-- Main Workspace Card -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.7*" MinHeight="280" />
                    <RowDefinition Height="1*" MinHeight="185" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" MinWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <!-- Top-Left: Internal Reconciliation Browser -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,2,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Internal Reconciliation Browser"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="AutoRefreshBadge"
                                       Text="⚡ Auto-Refresh: 5s"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,0" />

                            <TextBlock Text="⏱ Interval:"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="4,0,4,0" />

                            <ComboBox x:Name="RefreshCombo"
                                      Width="68"
                                      FontFamily="Segoe UI"
                                      FontSize="11"
                                      IsEditable="True"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,8,0"
                                      SelectionChanged="RefreshCombo_SelectionChanged"
                                      KeyDown="RefreshCombo_KeyDown"
                                      LostFocus="RefreshCombo_LostFocus" />

                            <Button x:Name="SoundBtn"
                                    Content="🔔 Sound: On"
                                    Background="#F1F5F9"
                                    Foreground="#16A34A"
                                    BorderThickness="0"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Padding="8,2"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Click="SoundBtn_Click" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button x:Name="BackBtn"
                                    Content="◀ Go Back"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,3"
                                    FontSize="11.5"
                                    Margin="0,0,4,0"
                                    Click="BackBtn_Click" />
                            <Button x:Name="ReloadBtn"
                                    Content="🔄 Reload"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,3"
                                    FontSize="11.5"
                                    Margin="0,0,4,0"
                                    Click="ReloadBtn_Click" />
                            <Button x:Name="HomeBtn"
                                    Content="🏠 Reconciliation"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,3"
                                    FontSize="11.5"
                                    Click="HomeBtn_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#E2E8F0"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">
                        <wf:WindowsFormsHost x:Name="ReconciliationBrowserHost"
                                             Background="#E2E8F0"
                                             SizeChanged="ReconciliationBrowserHost_SizeChanged" />
                    </Border>
                </Grid>

                <!-- Splitter between Browsers -->
                <GridSplitter Grid.Row="0"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="#E2E8F0"
                              ShowsPreview="False"
                              Margin="1,0,1,6"
                              Cursor="SizeWE" />

                <!-- Top-Right: Loading History Browser -->
                <Grid Grid.Row="0" Grid.Column="2" Margin="2,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6" MinHeight="26">
                        <TextBlock x:Name="LoadingHistoryHeaderTitle"
                                   Text="Loading History — enter Gate Pass manually"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#E2E8F0"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">
                        <wf:WindowsFormsHost x:Name="LoadingHistoryBrowserHost"
                                             Background="#E2E8F0"
                                             SizeChanged="LoadingHistoryBrowserHost_SizeChanged" />
                    </Border>
                </Grid>

                <!-- Bottom: Reconciliation Job IDs & Status Console -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Reconciliation Job IDs &amp; Status"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ExportCsvBtn"
                                    Content="📄 Export CSV"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,3"
                                    FontSize="11.5"
                                    Margin="0,0,4,0"
                                    Click="ExportCsvBtn_Click" />
                            <Button x:Name="CopyBtn"
                                    Content="📋 Copy"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,3"
                                    FontSize="11.5"
                                    Click="CopyBtn_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="JobsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              Background="#FFFFFF"
                              RowHeight="26"
                              FontFamily="Segoe UI"
                              FontSize="12"
                              SelectionChanged="JobsGrid_SelectionChanged"
                              PreviewKeyDown="JobsGrid_PreviewKeyDown"
                              MouseDoubleClick="JobsGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#F8FAFC" />
                                <Setter Property="Foreground" Value="#334155" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTag}" Value="pending">
                                        <Setter Property="Background" Value="#FEE2E2" />
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTag}" Value="in_progress">
                                        <Setter Property="Background" Value="#FEF9C3" />
                                        <Setter Property="Foreground" Value="#B45309" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTag}" Value="completed">
                                        <Setter Property="Background" Value="#DCFCE7" />
                                        <Setter Property="Foreground" Value="#15803D" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#0EA5E9" />
                                        <Setter Property="BorderThickness" Value="0,1,0,1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assigned User"
                                                Binding="{Binding AssignedUser}"
                                                Width="180"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="Job ID"
                                                Binding="{Binding JobId}"
                                                Width="240"
                                                MinWidth="140" />
                            <DataGridTextColumn Header="Client"
                                                Binding="{Binding Client}"
                                                Width="180"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="Reconciliation Status"
                                                Binding="{Binding Status}"
                                                Width="220"
                                                MinWidth="130" />
                            <DataGridTemplateColumn Header="Action" Width="110" MinWidth="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶ Start"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#EA580C"
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Click="StartRowBtn_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Action Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="CreateGatepassBtn"
                                Content="Create Gatepass"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,6"
                                FontSize="12"
                                FontWeight="Bold"
                                Click="CreateGatepassBtn_Click" />

                        <Button x:Name="DownloadExcelBtn"
                                Content="📥 Download Excel Sheets"
                                Background="#0284C7"
                                Foreground="#FFFFFF"
                                Padding="16,6"
                                FontSize="12"
                                FontWeight="Bold"
                                Style="{StaticResource NexusButtonBase}"
                                Margin="10,0,0,0"
                                Click="DownloadExcelBtn_Click" />

                        <Button x:Name="DownloadLoadingHistoryBtn"
                                Content="📥 Download Loading History"
                                Style="{StaticResource BlueButtonStyle}"
                                Padding="16,6"
                                FontSize="12"
                                FontWeight="Bold"
                                Margin="10,0,0,0"
                                Click="DownloadLoadingHistoryBtn_Click" />

                        <Button x:Name="OpenFolderBtn"
                                Content="📂 Open Folder"
                                Background="#334155"
                                Foreground="#FFFFFF"
                                Padding="16,6"
                                FontSize="12"
                                FontWeight="Bold"
                                Style="{StaticResource NexusButtonBase}"
                                Margin="10,0,0,0"
                                Click="OpenFolderBtn_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
