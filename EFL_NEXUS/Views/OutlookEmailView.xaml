<UserControl x:Class="EflNexus.App.Views.OutlookEmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F2">
    <UserControl.Resources>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Background" Value="#162E4C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3F66" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComposerLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ComposerEntryStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FlatPrimaryBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#0B1420" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162E4C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatSecondaryBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatDangerBtn" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAF8F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#0B1420" Padding="20,16,20,14">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Outlook Email Sender"
                               DockPanel.Dock="Left"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CountsText"
                                   Text="GDN sent: 0    GRN sent: 0"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button x:Name="ViewRecordsBtn"
                                Content="View Records"
                                Style="{StaticResource HeaderActionButton}"
                                Margin="0,0,6,0"
                                Click="ViewRecords_Click" />
                        <Button x:Name="SettingsBtn"
                                Content="⚙ Settings"
                                Style="{StaticResource HeaderActionButton}"
                                Click="Settings_Click" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="GDN / GRN direct dispatch engine with live activity logging"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Split Container -->
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Email Composer -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Template -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Template:" Style="{StaticResource ComposerLabelStyle}" Margin="0,4" />
                    <Grid Grid.Row="0" Grid.Column="1" Margin="10,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TemplateCombo"
                                  Grid.Column="0"
                                  FontSize="13"
                                  Padding="6,4"
                                  IsEditable="False"
                                  SelectionChanged="TemplateCombo_SelectionChanged" />
                        <Button Grid.Column="1"
                                Content="Add New Template"
                                Style="{StaticResource FlatSecondaryBtn}"
                                Margin="10,0,0,0"
                                Click="AddTemplate_Click" />
                    </Grid>

                    <!-- 2. To -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="To:" Style="{StaticResource ComposerLabelStyle}" Margin="0,4" />
                    <TextBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ComposerEntryStyle}" Margin="10,4,0,4" />

                    <!-- 3. CC -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CC:" Style="{StaticResource ComposerLabelStyle}" Margin="0,4" />
                    <TextBox x:Name="CcBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ComposerEntryStyle}" Margin="10,4,0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="(multiple recipients: separate with , or ;)"
                               FontSize="10.5"
                               Foreground="#64748B"
                               Margin="10,0,0,2" />

                    <!-- 4. Subject -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Subject:" Style="{StaticResource ComposerLabelStyle}" Margin="0,8,0,4" />
                    <TextBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource ComposerEntryStyle}" Margin="10,8,0,4" />

                    <!-- 5. Type -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Type:" Style="{StaticResource ComposerLabelStyle}" Margin="0,0,0,4" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,4" VerticalAlignment="Center">
                        <Button x:Name="GdnTypeBtn" Content="GDN" Style="{StaticResource FlatSecondaryBtn}" Click="SelectGdn_Click" />
                        <Button x:Name="GrnTypeBtn" Content="GRN" Style="{StaticResource FlatSecondaryBtn}" Margin="6,0,0,0" Click="SelectGrn_Click" />
                        <Button x:Name="ClearTypeBtn" Content="Clear" Style="{StaticResource FlatSecondaryBtn}" Margin="6,0,0,0" Click="ClearType_Click" />
                        <TextBlock Text="(sets 'GDN -' / 'GRN -' prefix &amp; logs gate pass)"
                                   FontSize="10.5"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- 6. Message -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Message:" Style="{StaticResource ComposerLabelStyle}" VerticalAlignment="Top" Margin="0,8,0,4" />
                    <RichTextBox x:Name="MessageRichBox"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Margin="10,8,0,4"
                                 MinHeight="135"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 BorderBrush="#94A3B8"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 PreviewKeyDown="MessageRichBox_PreviewKeyDown" />

                    <!-- 7. Signature Toggle -->
                    <CheckBox x:Name="IncludeSignatureCheck"
                              Grid.Row="7"
                              Grid.Column="1"
                              IsChecked="True"
                              Content="Include my default Outlook signature"
                              FontSize="13"
                              Foreground="#0F172A"
                              Margin="10,4,0,0" />

                    <!-- 8. Attachments -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Attachments:" Style="{StaticResource ComposerLabelStyle}" VerticalAlignment="Top" Margin="0,8,0,4" />
                    <StackPanel Grid.Row="8" Grid.Column="1" Margin="10,8,0,4">
                        <ListBox x:Name="AttachmentsListBox"
                                 Height="66"
                                 FontSize="13"
                                 BorderBrush="#94A3B8"
                                 BorderThickness="1"
                                 SelectionMode="Extended" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Attach PDF(s) / Excel(s)..."
                                    Style="{StaticResource FlatSecondaryBtn}"
                                    Click="AttachFiles_Click" />
                            <Button Content="Remove Selected"
                                    Style="{StaticResource FlatDangerBtn}"
                                    Margin="6,0,0,0"
                                    Click="RemoveSelectedAttachment_Click" />
                            <Button Content="Clear All"
                                    Style="{StaticResource FlatSecondaryBtn}"
                                    Margin="6,0,0,0"
                                    Click="ClearAttachments_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Bottom Action Buttons & Toast -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <Button x:Name="PreviewBtn"
                            Content="Preview in Outlook"
                            Style="{StaticResource FlatSecondaryBtn}"
                            Click="PreviewEmail_Click" />
                    <Button x:Name="SendBtn"
                            Content="Send"
                            Style="{StaticResource FlatPrimaryBtn}"
                            Margin="10,0,0,0"
                            Click="SendEmail_Click" />
                    <TextBlock x:Name="ToastText"
                               Text=""
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- RIGHT PANEL: Live Activity & Dispatch Log -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <DockPanel Grid.Row="0" Margin="14,10" LastChildFill="False">
                        <TextBlock Text="📋 Activity &amp; Dispatch Log"
                                   DockPanel.Dock="Left"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ClearLogBtn"
                                DockPanel.Dock="Right"
                                Content="Clear Log"
                                Cursor="Hand"
                                Click="ClearLog_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="FontSize" Value="10.5" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="8,3" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                                                        <Setter Property="Foreground" Value="#0F172A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>

                    <!-- Status Banner -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Margin="12,0,12,8"
                            Padding="14,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ActivityStatusDot"
                                           Text="●"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#16A34A"
                                           Margin="0,0,4,0" />
                                <TextBlock x:Name="ActivityStatusText"
                                           Text="System Ready"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#334155" />
                            </StackPanel>
                            <TextBlock x:Name="ActivityKpiText"
                                       DockPanel.Dock="Right"
                                       Text="Session: 0"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Rich Activity Log Text Box -->
                    <RichTextBox x:Name="ActivityRichBox"
                                 Grid.Row="2"
                                 Margin="12,4,12,10"
                                 IsReadOnly="True"
                                 FontFamily="Segoe UI"
                                 FontSize="12"
                                 Background="#FFFFFF"
                                 Foreground="#0F172A"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
