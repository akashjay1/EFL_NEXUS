<Window x:Class="EflNexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EFL NEXUS"
        Width="1560"
        Height="940"
        MinWidth="1050"
        MinHeight="700"
        Background="#FAF8F2"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Grid Grid.Column="0" Background="#0B1420">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand Row -->
            <StackPanel x:Name="BrandExpandedPanel"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="14,18,14,18"
                        VerticalAlignment="Center">
                <Image x:Name="BrandLogoImage"
                       Width="24"
                       Height="24"
                       Margin="0,0,10,0"
                       Visibility="Collapsed" />
                <TextBlock Text="EFL NEXUS"
                           FontFamily="Segoe UI"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="BrandCollapsedPanel"
                  Grid.Row="0"
                  Margin="14,18,14,18"
                  Visibility="Collapsed">
                <Image x:Name="BrandLogoCollapsedImage"
                       Width="24"
                       Height="24"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />
                <TextBlock x:Name="BrandCollapsedText"
                           Text="EN"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center" />
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="#142338" Margin="12,0,12,14" />

            <!-- Navigation Buttons Host -->
            <StackPanel x:Name="NavItemsPanel" Grid.Row="2" />

            <!-- Spacer (Row 3) -->

            <!-- Online Status Badge & Version -->
            <Border x:Name="SidebarStatusBox"
                    Grid.Row="4"
                    Background="#101D2D"
                    Padding="10,8"
                    Margin="12,0,12,12">
                <StackPanel>
                    <TextBlock x:Name="SidebarStatusText"
                               Text="● System Online"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#49CF9E" />
                    <TextBlock x:Name="SidebarVersionText"
                               Text="v1.0.8"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#64748B"
                               Cursor="Hand"
                               ToolTip="Click to view What's New / Release Notes"
                               MouseLeftButtonUp="SidebarVersionText_Click" />
                </StackPanel>
            </Border>

            <!-- Collapse Toggle -->
            <Border Grid.Row="5"
                    x:Name="CollapseToggleBtn"
                    Background="#0B1420"
                    Cursor="Hand"
                    Padding="10,8"
                    Margin="10,0,10,14"
                    MouseLeftButtonUp="CollapseToggle_Click"
                    MouseEnter="CollapseToggle_MouseEnter"
                    MouseLeave="CollapseToggle_MouseLeave">
                <TextBlock x:Name="CollapseToggleText"
                           Text="◀   Collapse"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Left" />
            </Border>
        </Grid>

        <!-- Content Area (Stacked Pages + Loading Spinner Overlay) -->
        <Grid Grid.Column="1" Background="#FAF8F2">
            <Grid x:Name="PageDashboardHost" />
            <Grid x:Name="PageTool1Host" Visibility="Collapsed" />
            <Grid x:Name="PageTool2Host" Visibility="Collapsed" />
            <Grid x:Name="PageTool3Host" Visibility="Collapsed" />
            <Grid x:Name="PageTool4Host" Visibility="Collapsed" />
            <Grid x:Name="PageTool5Host" Visibility="Collapsed" />
            <Grid x:Name="PageTool6Host" Visibility="Collapsed" />
            <Grid x:Name="PagePackingListHost" Visibility="Collapsed" />
            <Grid x:Name="PageWhatsappHost" Visibility="Collapsed" />
            <Grid x:Name="PageSettingsHost" Visibility="Collapsed" />

            <!-- 12-Segment Fade-Arc Loading Spinner Overlay -->
            <Grid x:Name="LoadingOverlay" Background="#FAF8F2" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
                    <Canvas x:Name="SpinnerCanvas"
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingTitleText"
                               Text="Loading Module..."
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#334155"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4" />
                    <TextBlock Text="Initializing components"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
