<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aurora Obsidian & Borealis Color Palette (exact 1:1 match with main_app.py) -->
    <Color x:Key="BaseBgColor">#FAF8F2</Color>
    <Color x:Key="SidebarBgColor">#0B1420</Color>
    <Color x:Key="SidebarBorderColor">#142338</Color>
    <Color x:Key="SidebarBgHoverColor">#13233A</Color>
    <Color x:Key="SidebarBgActiveColor">#162E4C</Color>
    <Color x:Key="AuroraCyanColor">#00E5FF</Color>
    <Color x:Key="AuroraMintColor">#49CF9E</Color>
    <Color x:Key="AuroraSapphireColor">#00B7FF</Color>
    <Color x:Key="AuroraAmberColor">#FF6B00</Color>
    <Color x:Key="SidebarFgColor">#94A3B8</Color>
    <Color x:Key="SidebarFgActiveColor">#FFFFFF</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#E2E8F0</Color>
    <Color x:Key="CardTextMainColor">#0F172A</Color>
    <Color x:Key="CardTextMutedColor">#64748B</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerDarkColor">#B91C1C</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="PrimaryBlueColor">#2563EB</Color>
    <Color x:Key="PrimaryBlueHoverColor">#1D4ED8</Color>

    <SolidColorBrush x:Key="BaseBgBrush" Color="{StaticResource BaseBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}" />
    <SolidColorBrush x:Key="SidebarBgHoverBrush" Color="{StaticResource SidebarBgHoverColor}" />
    <SolidColorBrush x:Key="SidebarBgActiveBrush" Color="{StaticResource SidebarBgActiveColor}" />
    <SolidColorBrush x:Key="AuroraCyanBrush" Color="{StaticResource AuroraCyanColor}" />
    <SolidColorBrush x:Key="AuroraMintBrush" Color="{StaticResource AuroraMintColor}" />
    <SolidColorBrush x:Key="AuroraSapphireBrush" Color="{StaticResource AuroraSapphireColor}" />
    <SolidColorBrush x:Key="AuroraAmberBrush" Color="{StaticResource AuroraAmberColor}" />
    <SolidColorBrush x:Key="SidebarFgBrush" Color="{StaticResource SidebarFgColor}" />
    <SolidColorBrush x:Key="SidebarFgActiveBrush" Color="{StaticResource SidebarFgActiveColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardTextMainBrush" Color="{StaticResource CardTextMainColor}" />
    <SolidColorBrush x:Key="CardTextMutedBrush" Color="{StaticResource CardTextMutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}" />
    <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="{StaticResource PrimaryBlueHoverColor}" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Background" Value="{StaticResource BaseBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CardTextMainBrush}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource CardTextMainBrush}" />
    </Style>

    <Style x:Key="MutedDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource CardTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CardTextMainBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NexusButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#0EA5E9" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0284C7" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1D4ED8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#16A34A" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#15803D" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AmberButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#FF6B00" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EA580C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#DC2626" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B91C1C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#0B1420" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#162E4C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NexusButtonBase}">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E2E8F0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
